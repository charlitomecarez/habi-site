---
import { groups } from '../data/site';

// A running index across every group, so the weave plays as one wave down the page.
const starts = groups.map((_, gi) => groups.slice(0, gi).reduce((n, g) => n + g.modules.length, 0));
---

<section class="wrap mosaic" data-in>
  <div class="head">
    <h2 class="rise">Everything else, woven in.</h2>
    <p>A gold corner means it needs a free key.</p>
  </div>
  <div class="groups">
    {groups.map((g, gi) => (
      <div class="group">
        <h3>{g.title}</h3>
        <ul>
          {g.modules.map((m, i) => (
            <li class:list={['tile', `field-${g.field}`, i % 2 === 0 ? 'tile--a' : 'tile--b']} style={`--i:${starts[gi] + i}`}>
              {m.key && <span class="corner" role="img" aria-label="Needs a free key"></span>}
              <span class="name">{m.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .mosaic {
    padding-block: 96px 88px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
  }

  h2 {
    max-width: 16ch;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .head p {
    max-width: 40ch;
    color: rgb(var(--fg-muted));
  }

  .groups {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h3 {
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 6px;
  }

  .tile {
    position: relative;
    overflow: hidden;
    min-height: 104px;
    padding: 16px;
    display: flex;
    align-items: flex-end;
    color: rgb(var(--on-field));
    background-color: rgb(var(--field));
    background-image:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 12px, transparent 12px 24px),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.12) 0 12px, transparent 12px 24px);
  }

  .tile--a {
    border-radius: 18px 4px 18px 4px;
  }

  .tile--b {
    border-radius: 4px 18px 4px 18px;
  }

  /* Tiles weave in like strips of banig: warp from the left, weft from the right. */
  .tile {
    transition:
      clip-path 800ms var(--ease) calc(200ms + min(var(--i) * 45ms, 900ms)),
      transform 800ms var(--ease) calc(200ms + min(var(--i) * 45ms, 900ms));
  }

  .tile .name,
  .tile .corner {
    transition: opacity 500ms var(--ease) calc(500ms + min(var(--i) * 45ms, 900ms));
  }

  :global(.motion) [data-in]:not(.is-in) .tile--a {
    clip-path: inset(0 100% 0 0);
    transform: translateX(-12px);
  }

  :global(.motion) [data-in]:not(.is-in) .tile--b {
    clip-path: inset(0 0 0 100%);
    transform: translateX(12px);
  }

  :global(.motion) [data-in]:not(.is-in) .tile .name,
  :global(.motion) [data-in]:not(.is-in) .tile .corner {
    opacity: 0;
  }

  .corner {
    position: absolute;
    top: 0;
    right: 0;
    border-style: solid;
    border-width: 0 28px 28px 0;
    border-color: transparent rgb(var(--gold)) transparent transparent;
  }

  .name {
    font-size: 20px;
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: -0.01em;
  }
</style>
