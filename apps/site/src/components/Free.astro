---
const lines = [
  ['Supabase', 'Database and sign-in'],
  ['expo.dev', 'Builds the APK'],
  ['Google', 'Sign in with Google'],
  ['Firebase', 'Push notifications'],
];
---

<section id="free" class="wrap free" data-in>
  <div class="text">
    <h2>
      <span class="zero">₱0</span>
      <span class="sub">A month, for your own copy.</span>
    </h2>
  </div>
  <div class="receipt-wrap">
    <div class="receipt">
      <div class="receipt-head">
        <span class="receipt-title">Habi</span>
        <span class="muted small">Monthly bill for one person</span>
      </div>
      {lines.map(([name, what], i) => (
        <div class="line" style={`--i:${i}`}>
          <span><strong>{name}</strong><br /><span class="muted small">{what}</span></span>
          <span class="cost">₱0.00</span>
        </div>
      ))}
      <div class="line total" style="--i:4"><span>Total</span><span class="good">₱0.00</span></div>
      <p class="keys">Sports, Inbox, Ulam and Find a work need a free key that you get yourself.</p>
    </div>
    <div class="tear" aria-hidden="true"></div>
  </div>
</section>

<style>
  .free {
    padding-block: 96px 72px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .text {
    flex: 1 1 340px;
    min-width: 0;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h2 {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .zero {
    font-size: clamp(120px, 16vw, 220px);
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: rgb(var(--good));
  }

  .sub {
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .receipt-wrap {
    flex: 0 1 400px;
    min-width: 0;
    transform: rotate(1.5deg);
  }

  .receipt {
    background: rgb(var(--card));
    border: 2px solid rgb(var(--border-input));
    border-bottom: 0;
    padding: 28px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .receipt-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding-bottom: 14px;
    border-bottom: 2px dashed rgb(var(--border-input));
  }

  .receipt-title {
    font-weight: 900;
    font-size: 20px;
  }

  .muted {
    color: rgb(var(--fg-muted));
  }

  .small {
    font-size: 14px;
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .cost {
    font-weight: 700;
  }

  .total {
    padding-top: 14px;
    border-top: 2px dashed rgb(var(--border-input));
    font-size: 22px;
    font-weight: 900;
  }

  .good {
    color: rgb(var(--good));
  }

  .keys {
    padding: 10px 12px;
    border-radius: 10px;
    background: rgb(var(--watch-tint));
    font-size: 14px;
  }

  /* The bill prints out of a slot, line by line, then ₱0 lands. */
  .receipt-wrap {
    transition: clip-path 1200ms var(--ease) 150ms;
  }

  .receipt {
    transition: transform 1200ms var(--ease) 150ms;
  }

  .line {
    transition: opacity 400ms var(--ease) calc(500ms + var(--i) * 140ms);
  }

  .zero {
    display: inline-block;
    transition:
      transform 900ms var(--ease) 1150ms,
      opacity 500ms var(--ease) 1150ms,
      filter 700ms var(--ease) 1150ms;
  }

  :global(.motion) [data-in]:not(.is-in) .receipt-wrap {
    clip-path: inset(0 -24px 100% -24px);
  }

  :global(.motion) [data-in]:not(.is-in) .receipt {
    transform: translateY(-40%);
  }

  :global(.motion) [data-in]:not(.is-in) .line {
    opacity: 0;
  }

  :global(.motion) [data-in]:not(.is-in) .zero {
    opacity: 0;
    transform: scale(1.18);
    filter: blur(10px);
  }

  .tear {
    height: 14px;
    background-image: radial-gradient(circle at 10px 0, transparent 9px, rgb(var(--card)) 9.5px);
    background-size: 20px 14px;
    background-repeat: repeat-x;
  }
</style>
