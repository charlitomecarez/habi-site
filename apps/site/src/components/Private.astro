---
const points = [
  ['The server only sees scrambled text.', 'Your vault is encrypted on the phone.'],
  ['Each account sees only its own rows.', 'Every table has row-level security.'],
  ['Steps, sleep and screen time never leave the phone.', ''],
];
---

<section id="private" class="weave weave--deep field-shell on-dark" data-in>
  <div class="wrap row">
    <div class="intro">
      <div class="padlock" aria-hidden="true">
        <div class="shackle"></div>
        <div class="lockbody"><div class="hole"></div></div>
      </div>
      <h2 class="rise" style="--d:150ms">Your life stays yours.</h2>
    </div>
    <ul>
      {points.map(([title, body], i) => (
        <li class="thread" style={`--i:${i + 1}`}>
          <span class="title">{title}</span>
          {body && <span class="body">{body}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .row {
    padding-block: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
    align-items: flex-start;
  }

  .intro {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .padlock {
    width: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .shackle {
    width: 64px;
    height: 52px;
    border: 12px solid rgb(var(--on-field));
    border-bottom: 0;
    border-radius: 40px 40px 0 0;
  }

  .lockbody {
    width: 120px;
    height: 96px;
    border-radius: 18px;
    background: rgb(var(--on-field));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hole {
    width: 16px;
    height: 34px;
    border-radius: 8px;
    background: rgb(var(--shell-field));
  }

  /* The padlock arrives open, then the shackle drops shut. */
  .padlock {
    transition: transform 600ms var(--ease), opacity 400ms var(--ease);
  }

  .shackle {
    transition: transform 450ms cubic-bezier(0.5, 0, 0.75, 0) 650ms;
  }

  @keyframes clunk {
    40% {
      transform: translateY(4px);
    }
  }

  :global(.motion) [data-in].is-in .lockbody {
    animation: clunk 320ms var(--ease) 1080ms;
  }

  :global(.motion) [data-in]:not(.is-in) .padlock {
    opacity: 0;
    transform: translateY(24px);
  }

  :global(.motion) [data-in]:not(.is-in) .shackle {
    transform: translateY(-26px);
  }

  h2 {
    font-size: clamp(40px, 5vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  ul {
    flex: 2 1 480px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 24px 0;
    border-top: 3px solid rgb(var(--on-field) / 0.5);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  li:last-child {
    border-bottom: 3px solid rgb(var(--on-field) / 0.5);
  }

  .title {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .body {
    opacity: 0.85;
  }
</style>
