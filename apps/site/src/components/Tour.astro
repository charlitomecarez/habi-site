---
const stops = [
  { id: 't-home', label: 'Home', field: 'shell' },
  { id: 't-todos', label: 'Todos', field: 'daily' },
  { id: 't-vault', label: 'Vault', field: 'people' },
  { id: 't-money', label: 'Money', field: 'records' },
  { id: 't-vehicle', label: 'Vehicle', field: 'home' },
];
const services = [
  { name: 'Oil change', status: 'Due soon', kind: 'watch', fill: 88, note: 'At 12,600 km. 120 km left.' },
  { name: 'Tire check', status: 'On track', kind: 'plain', fill: 45, note: 'At 18,000 km. 5,520 km left.' },
  { name: 'Brake check', status: 'Overdue', kind: 'over', fill: 100, note: 'Was due at 12,000 km.' },
];
---

<section id="tour" class="tour">
  <div class="wrap head">
    <h2>Five screens you'd open every day.</h2>
    <div class="head-tools">
      <nav aria-label="Tour stops">
        {stops.map((s) => <a href={`#${s.id}`} class={`field-${s.field}`}>{s.label}</a>)}
      </nav>
      <button type="button" class="pause" data-loop-toggle aria-pressed="false" hidden>
        <svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
        <svg class="i-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5l12 7-12 7z"></path></svg>
        <span data-loop-label>Pause screens</span>
      </button>
    </div>
  </div>

  <!-- Home: the one full phone -->
  <div id="t-home" class="weave weave--deep field-shell on-dark" data-reveal>
    <div class="wrap band band--split">
      <div class="text">
        <h3 class="big">Home speaks first.</h3>
        <p class="lead">Every module feeds one sentence: what today needs.</p>
        <ul class="legend">
          <li><span class="key key--good" aria-hidden="true"></span>Green: the day went to plan</li>
          <li><span class="key key--watch" aria-hidden="true"></span>Gold: something needs a look</li>
          <li><span class="key key--over" aria-hidden="true"></span>Pink: something went over</li>
        </ul>
      </div>
      <div class="phone" data-clip>
        <video
          muted
          loop
          playsinline
          preload="none"
          width="560"
          height="1120"
          poster="/ads/home-screen.webp"
          aria-label="Home screen: the week band redraws and Friday is ringed. Home says three things need you, then rent is due today, then you spent ₱55 on merienda, then 6,900 steps, and each matching tile updates."
        >
          <source src="/ads/home-screen.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>

  <!-- Todos and Vault, side by side -->
  <div class="pair">
    <div id="t-todos" class="weave field-daily on-dark" data-reveal>
      <div class="band band--half">
        <h3 class="mid">Todos that remind you.</h3>
        <p class="lead">Give one a time and your phone reminds you. Check it off and Home stops asking.</p>
        <figure class="clip" data-clip>
          <video muted loop playsinline preload="none" width="760" height="430" poster="/ads/todos-card.webp" aria-label="Todo list: a reminder for Send rent to Ate drops in at 5:00 PM. Rent gets checked off, and Buy rice, 5 kg gets a reminder for tomorrow, 9:00 AM.">
            <source src="/ads/todos-card.mp4" type="video/mp4" />
          </video>
        </figure>
      </div>
    </div>
    <div id="t-vault" class="weave field-people on-dark" data-reveal>
      <div class="band band--half">
        <h3 class="mid">A vault that stays locked.</h3>
        <p class="lead">Encrypted on your phone. Only your PIN opens it.</p>
        <figure class="clip" data-clip>
          <video muted loop playsinline preload="none" width="760" height="538" poster="/ads/vault-card.webp" aria-label="Vault: a PIN is entered and the vault opens. The GCash password is copied and clears in 30 seconds, then the vault locks itself again.">
            <source src="/ads/vault-card.mp4" type="video/mp4" />
          </video>
        </figure>
      </div>
    </div>
  </div>

  <!-- Money as an equation -->
  <div id="t-money" class="weave field-records on-dark" data-reveal>
    <div class="wrap band band--stack">
      <div class="band-head">
        <h3 class="big">Money, in pesos.</h3>
        <p class="lead narrow">Every wallet adds up to one number, and bills say when they're due.</p>
      </div>
      <div class="sum" role="img" aria-label="GCash ₱3,410.20 plus MariBank ₱14,830.30 equals ₱18,240.50.">
        <div class="wallet" aria-hidden="true"><span class="wallet-name">GCash</span><span class="amount" data-amount="gcash">₱3,410.20</span><span class="float" data-float="gcash"></span></div>
        <span class="op" aria-hidden="true">+</span>
        <div class="wallet" aria-hidden="true"><span class="wallet-name">MariBank</span><span class="amount" data-amount="mari">₱14,830.30</span><span class="float" data-float="mari"></span></div>
        <span class="op" aria-hidden="true">=</span>
        <div class="wallet wallet--total" aria-hidden="true">
          <span class="wallet-name">Total</span>
          <span class="amount amount--total" data-count="18240.50" data-format="peso" data-amount="total">₱18,240.50</span>
        </div>
      </div>
      <div class="bills">
        <span class="bill">Meralco ₱2,315.40 <span class="pill pill--good bill-pill">Paid</span></span>
        <span class="bill" data-globe>Globe postpaid ₱1,299.00 <span class="pill pill--watch bill-pill" data-globe-pill>Due soon</span></span>
      </div>
    </div>
  </div>

  <!-- Vehicle as a big odometer -->
  <div id="t-vehicle" class="weave field-home on-dark" data-reveal>
    <div class="wrap band band--stack">
      <div class="band-head">
        <h3 class="big">Your vehicle knows its next service.</h3>
        <p class="lead narrow">Enter the odometer after a trip. Habi counts down to the next service.</p>
      </div>
      <div class="odo">
        <span class="odo-label">Odometer</span>
        <span class="odo-value" aria-hidden="true" data-count="12480" data-format="km" data-odo>12,480 km</span>
        <span class="sr-only">12,480 km</span>
      </div>
      <ul class="services">
        {services.map((s) => (
          <li data-service>
            <div class="service-head">
              <span class="service-name">{s.name}</span>
              <span class={`status status--${s.kind}`} data-status>{s.status}</span>
            </div>
            <div class="track" aria-hidden="true">
              <div class={`fill fill--${s.kind}`} style={`--f: ${s.fill / 100}`}></div>
            </div>
            <span data-note>{s.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const peso = new Intl.NumberFormat('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const whole = new Intl.NumberFormat('en-PH', { maximumFractionDigits: 0 });
  const format = (el: HTMLElement, n: number) =>
    el.dataset.format === 'peso' ? `₱${peso.format(n)}` : `${whole.format(n)} km`;

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.count);
    const start = performance.now();
    const duration = 1400;
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 4);
      el.textContent = format(el, target * eased);
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  if (!reduce && 'IntersectionObserver' in window) {
    const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
    counters.forEach((el) => (el.textContent = format(el, 0)));

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          entry.target.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  } else {
    document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
  }

  /* ---------------------------------------------------------------------------
     Live screens. After its entrance, each band replays a short story on repeat,
     but only while it is on screen and the visitor hasn't paused. Every story ends
     back on the resting state the markup shows, so stopping at any point settles
     smoothly onto the same picture people see with reduce motion on or JS off.
     --------------------------------------------------------------------------- */
  if (!reduce && 'IntersectionObserver' in window) {
    type Scene = { length: number; steps: [number, () => void][]; rest: () => void };

    const q = <T extends Element = HTMLElement>(root: ParentNode, sel: string) => root.querySelector<T>(sel)!;
    const qa = <T extends Element = HTMLElement>(root: ParentNode, sel: string) => Array.from(root.querySelectorAll<T>(sel));
    const flash = (el: Element, cls: string, ms = 900) => {
      el.classList.remove(cls);
      void (el as HTMLElement).offsetWidth; // restart the animation
      el.classList.add(cls);
      window.setTimeout(() => el.classList.remove(cls), ms);
    };

    // Tween a number shown as text; returns nothing, cancels any tween already running on el.
    const tweens = new WeakMap<Element, number>();
    function tween(el: HTMLElement, from: number, to: number, ms: number, show: (n: number) => string) {
      cancelAnimationFrame(tweens.get(el) ?? 0);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        el.textContent = show(from + (to - from) * e);
        if (t < 1) tweens.set(el, requestAnimationFrame(step));
      };
      tweens.set(el, requestAnimationFrame(step));
    }
    const stopTween = (el: Element) => cancelAnimationFrame(tweens.get(el) ?? 0);
    const pesoText = (n: number) => `₱${peso.format(n)}`;
    const kmText = (n: number) => `${whole.format(n)} km`;

    /* Money: Globe gets paid from GCash, then pay day lands in MariBank. The total follows. */
    function moneyScene(band: HTMLElement): Scene {
      const gcash = q(band, '[data-amount="gcash"]');
      const mari = q(band, '[data-amount="mari"]');
      const total = q(band, '[data-amount="total"]');
      const fG = q(band, '[data-float="gcash"]');
      const fM = q(band, '[data-float="mari"]');
      const pill = q(band, '[data-globe-pill]');
      const sum = q(band, '.sum');
      const bills = q(band, '.bills');
      const R = { g: 3410.2, m: 14830.3 };
      const setPill = (paid: boolean) => {
        pill.textContent = paid ? 'Paid' : 'Due soon';
        pill.className = `pill bill-pill ${paid ? 'pill--good' : 'pill--watch'}`;
      };
      const float = (el: HTMLElement, txt: string, kind: 'plus' | 'minus') => {
        el.textContent = txt;
        el.className = `float ${kind}`;
        void el.offsetWidth;
        el.classList.add('go');
      };
      const rest = () => {
        [gcash, mari, total].forEach(stopTween);
        gcash.textContent = pesoText(R.g);
        mari.textContent = pesoText(R.m);
        total.textContent = pesoText(R.g + R.m);
        setPill(false);
        [fG, fM].forEach((f) => (f.className = 'float'));
        qa(band, '.wallet').forEach((w) => w.classList.remove('is-hit'));
      };
      const hit = (el: HTMLElement, on: boolean) => el.closest('.wallet')!.classList.toggle('is-hit', on);
      return {
        length: 11500,
        steps: [
          [800, () => {
            setPill(true);
            flash(pill, 'pop', 500);
          }],
          [1100, () => {
            hit(gcash, true);
            float(fG, '−₱1,299.00', 'minus');
            tween(gcash, R.g, R.g - 1299, 1200, pesoText);
            tween(total, R.g + R.m, R.g + R.m - 1299, 1400, pesoText);
          }],
          [2600, () => hit(gcash, false)],
          [4600, () => {
            hit(mari, true);
            float(fM, '+₱2,500.00', 'plus');
            tween(mari, R.m, R.m + 2500, 1200, pesoText);
            tween(total, R.g + R.m - 1299, R.g + R.m + 1201, 1400, pesoText);
          }],
          [6100, () => hit(mari, false)],
          // A new week: fade out, settle back to the resting numbers, fade in.
          [8800, () => [sum, bills].forEach((el) => el.classList.add('is-resetting'))],
          [9200, () => rest()],
          [9300, () => [sum, bills].forEach((el) => el.classList.remove('is-resetting'))],
        ],
        rest() {
          rest();
          [sum, bills].forEach((el) => el.classList.remove('is-resetting'));
        },
      };
    }

    /* Vehicle: a trip runs the odometer up, the oil change comes due, then gets logged. */
    function vehicleScene(band: HTMLElement): Scene {
      const odo = q(band, '[data-odo]');
      const rows = qa(band, '[data-service]');
      const odoBox = q(band, '.odo');
      const list = q(band, '.services');
      const rowState = rows.map((r) => ({
        status: q(r, '[data-status]').textContent ?? '',
        cls: q(r, '[data-status]').className,
        fill: q(r, '.fill').style.getPropertyValue('--f'),
        fillCls: q(r, '.fill').className,
        note: q(r, '[data-note]').textContent ?? '',
      }));
      const [oil, tire] = rows;
      const setStatus = (row: HTMLElement, text: string, kind: string) => {
        const st = q(row, '[data-status]');
        st.textContent = text;
        st.className = `status status--${kind}`;
        q(row, '.fill').className = `fill fill--${kind}`;
        flash(st, 'pop', 500);
      };
      const setNote = (row: HTMLElement, text: string) => {
        const n = q(row, '[data-note]');
        n.classList.add('swap');
        window.setTimeout(() => {
          n.textContent = text;
          n.classList.remove('swap');
        }, 260);
      };
      const fill = (row: HTMLElement, f: number) => q(row, '.fill').style.setProperty('--f', String(f));
      const rest = () => {
        stopTween(odo);
        odo.textContent = kmText(12480);
        rows.forEach((r, i) => {
          const st = q(r, '[data-status]');
          st.textContent = rowState[i].status;
          st.className = rowState[i].cls;
          q(r, '.fill').className = rowState[i].fillCls;
          q(r, '.fill').style.setProperty('--f', rowState[i].fill);
          q(r, '[data-note]').textContent = rowState[i].note;
        });
      };
      return {
        length: 13000,
        steps: [
          [600, () => {
            tween(odo, 12480, 12612, 2600, kmText);
            fill(oil, 1);
            fill(tire, 0.47);
          }],
          [1900, () => setNote(oil, 'At 12,600 km. Due now.')],
          [3300, () => {
            setStatus(oil, 'Due now', 'over');
            setNote(tire, 'At 18,000 km. 5,388 km left.');
          }],
          [5600, () => setNote(oil, 'Logged at 12,612 km. Next at 15,612 km.')],
          [5800, () => fill(oil, 0.02)],
          [6200, () => setStatus(oil, 'On track', 'plain')],
          [10000, () => [odoBox, list].forEach((el) => el.classList.add('is-resetting'))],
          [10400, () => rest()],
          [10500, () => [odoBox, list].forEach((el) => el.classList.remove('is-resetting'))],
        ],
        rest() {
          rest();
          [odoBox, list].forEach((el) => el.classList.remove('is-resetting'));
        },
      };
    }

    const scenes: [string, (b: HTMLElement) => Scene][] = [
      ['#t-money', moneyScene],
      ['#t-vehicle', vehicleScene],
    ];

    const toggle = document.querySelector<HTMLButtonElement>('[data-loop-toggle]')!;
    const label = document.querySelector<HTMLElement>('[data-loop-label]')!;
    let paused = false;

    const players = scenes.map(([sel, make]) => {
      const band = document.querySelector<HTMLElement>(sel)!;
      const scene = make(band);
      let timers: number[] = [];
      let visible = false;
      let running = false;
      let firstRun = true;

      const clear = () => {
        timers.forEach(clearTimeout);
        timers = [];
      };
      const cycle = () => {
        clear();
        scene.steps.forEach(([ms, fn]) => timers.push(window.setTimeout(fn, ms)));
        timers.push(window.setTimeout(cycle, scene.length));
      };
      const start = () => {
        if (running) return;
        running = true;
        // Let the entrance finish before the story starts the first time.
        const wait = firstRun ? 1800 : 500;
        firstRun = false;
        timers.push(
          window.setTimeout(() => {
            band.setAttribute('data-live', '');
            cycle();
          }, wait),
        );
      };
      const stop = () => {
        if (!running) return;
        running = false;
        clear();
        scene.rest();
      };
      const sync = () => (visible && !paused && !document.hidden ? start() : stop());

      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          sync();
        },
        { threshold: 0.35 },
      ).observe(band);

      return { sync };
    });

    // The Todos and Vault bands play HyperFrames clips (ads/compositions/*-screen.html) instead of
    // live scenes. They follow the same rules: on screen, not paused, tab visible.
    document.querySelectorAll<HTMLElement>('[data-clip]').forEach((fig) => {
      const video = fig.querySelector('video')!;
      let visible = false;
      const sync = () => {
        const want = visible && !paused && !document.hidden;
        if (want && video.paused) video.play().catch(() => {});
        else if (!want && !video.paused) video.pause();
      };
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          sync();
        },
        { threshold: 0.35 },
      ).observe(fig);
      players.push({ sync });
    });

    // One control pauses every screen (WCAG 2.2.2: moving content can be paused).
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? 'Play screens' : 'Pause screens';
      players.forEach((p) => p.sync());
    });

    // Don't run stories in a background tab.
    document.addEventListener('visibilitychange', () => players.forEach((p) => p.sync()));
  }
</script>

<style>
  .tour {
    display: flex;
    flex-direction: column;
  }

  .head {
    width: 100%;
    padding-bottom: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(38px, 5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: rgb(var(--field));
    color: rgb(var(--on-field));
    text-decoration: none;
  }

  .band {
    display: flex;
  }

  .band--split {
    padding-block: 72px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 48px 64px;
  }

  .band--half {
    max-width: 520px;
    margin: 0 auto;
    padding: 72px 20px;
    flex-direction: column;
    gap: 24px;
  }

  .band--stack {
    padding-block: 80px;
    flex-direction: column;
    gap: 36px;
  }

  .band-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 48px;
  }

  .text {
    flex: 1 1 360px;
    min-width: 0;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .big {
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .mid {
    font-size: clamp(32px, 3.6vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .lead {
    font-size: 19px;
  }

  .narrow {
    max-width: 40ch;
  }

  .legend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-weight: 700;
  }

  .legend li {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .key {
    width: 22px;
    height: 6px;
    border-radius: 3px;
  }

  .key--good { background: rgb(var(--good-fill)); }
  .key--watch { background: rgb(var(--watch-fill)); }
  .key--over { background: rgb(var(--over-fill)); }

  /* Home phone */
  .phone video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 30px;
    background: rgb(var(--bg));
  }

  .phone {
    flex: 0 0 auto;
    margin: 0 auto;
    width: 300px;
    max-width: 100%;
    border-radius: 40px;
    padding: 10px;
    background: rgb(var(--bezel));
    box-shadow: 0 24px 48px rgb(0 0 0 / 0.3);
  }

  /* Todos and Vault */
  .pair {
    display: flex;
    flex-wrap: wrap;
  }

  .pair > div {
    flex: 1 1 440px;
    min-width: 0;
  }

  /* Money */
  .sum {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .wallet {
    flex: 1 1 200px;
    background: rgb(var(--card));
    color: rgb(var(--fg));
    border-radius: 18px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wallet-name {
    font-weight: 700;
    color: rgb(var(--fg-muted));
  }

  .wallet--total {
    flex: 1.3 1 240px;
    background: rgb(var(--shell-field));
    color: rgb(var(--on-field));
    border: 3px solid rgb(var(--on-field));
  }

  .wallet--total .wallet-name {
    color: inherit;
  }

  .amount {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .amount--total {
    font-size: clamp(32px, 4vw, 48px);
  }

  .op {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 900;
    line-height: 1;
  }

  .bills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-weight: 700;
  }

  .bill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgb(var(--card));
