---
import { CONTRIBUTING, REPO } from '../data/site';
---

<section id="top" class="hero on-dark" data-in>
  <div class="wrap grid">
    <div class="copy">
      <h1>One private app that tells you what needs you today.</h1>
      <p class="name"><strong lang="tl">Habi</strong> is Tagalog for "weave". The app weaves each part of your day into one Home, and the weave band is already its look.</p>
      <p class="lede">Todos, money, your ride and more, in one app.</p>
      <div class="ctas">
        <a class="btn btn--cream" href={CONTRIBUTING}>
          Make your own copy
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="btn btn--ghost" href={REPO}>See the source</a>
      </div>
      <p class="note">Open source · Android · ₱0 a month. You build your own copy; it's not on the Play Store.</p>
    </div>

    <!-- The 26 s HyperFrames ad (source: ads/compositions/master.html in the repo root). -->
    <div class="stage">
      <figure class="reel" data-hero-reel>
        <video
          muted
          loop
          playsinline
          preload="metadata"
          poster="/ads/master.webp"
          aria-label="Ad: the Habi tour. Home types what needs you, a todo gets checked off, Money adds up the wallets, the odometer climbs to the next oil change, and the vault unlocks with a PIN. Then ₱0 a month to run, and Make your own copy."
        >
          <source src="/ads/master.mp4" type="video/mp4" />
        </video>
      </figure>
    </div>
  </div>
  <div class="strip"></div>
</section>

<script>
  // The ad plays while it's on screen. With reduce motion on, it stays on its poster frame.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fig = document.querySelector<HTMLElement>('[data-hero-reel]')!;
  const video = fig.querySelector('video')!;
  let visible = false;
  // Decoding video is heavy on a phone, so it waits until the page has settled: the visitor's first
  // scroll, tap or key, or a few seconds after load. Until then the poster frame shows.
  let ready = false;

  const sync = () => {
    const want = ready && visible && !reduce && !document.hidden;
    if (want && video.paused) video.play().catch(() => {});
    else if (!want && !video.paused) video.pause();
  };

  const start = () => {
    if (ready) return;
    ready = true;
    sync();
  };
  ['pointerdown', 'pointermove', 'keydown', 'scroll', 'touchstart'].forEach((type) =>
    window.addEventListener(type, start, { once: true, passive: true }),
  );
  const later = () => window.setTimeout(start, 4000);
  if (document.readyState === 'complete') later();
  else window.addEventListener('load', later, { once: true });

  new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting;
      sync();
    },
    { threshold: 0.3 },
  ).observe(fig);
  document.addEventListener('visibilitychange', sync);
</script>

<style>
  .hero {
    background: rgb(var(--shell));
    color: rgb(var(--on-shell));
  }

  /* Entrance: the copy comes into focus line by line while the ad settles in. */
  @keyframes hero-focus {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(8px);
    }
  }

  @keyframes reel-settle {
    from {
      opacity: 0;
      transform: translateY(72px) rotate(-5deg) scale(0.94);
    }
  }

  :global(.motion) .copy > * {
    animation: hero-focus 900ms var(--ease) both;
  }

  :global(.motion) .copy > :nth-child(2) { animation-delay: 90ms; }
  :global(.motion) .copy > :nth-child(3) { animation-delay: 200ms; }
  :global(.motion) .copy > :nth-child(4) { animation-delay: 290ms; }
  :global(.motion) .copy > :nth-child(5) { animation-delay: 360ms; }
  :global(.motion) .copy > :nth-child(6) { animation-delay: 440ms; }

  :global(.motion) .stage {
    animation: reel-settle 1100ms var(--ease) 150ms both;
  }

  .grid {
    padding-block: 48px 72px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .copy {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    font-size: clamp(38px, 5.4vw, 66px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  /* Why it's called Habi: a quiet aside under the headline, set off by a short weave stitch. */
  .name {
    position: relative;
    max-width: 46ch;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.88;
  }

  .name::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    bottom: 3px;
    width: 4px;
    border-radius: 2px;
    background: repeating-linear-gradient(
      180deg,
      rgb(var(--good-fill)) 0 6px,
      rgb(var(--watch-fill)) 6px 12px,
      rgb(var(--over-fill)) 12px 18px
    );
  }

  .name strong {
    color: rgb(var(--gold));
    font-weight: 900;
  }

  .lede {
    font-size: 19px;
    line-height: 1.5;
    max-width: 34ch;
    text-wrap: balance;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .note {
    font-size: 14px;
    opacity: 0.85;
  }

  /* The ad */
  .stage {
    flex: 0 0 auto;
    margin: 0 auto;
    width: 340px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .reel {
    margin: 0;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 28px;
    overflow: hidden;
    background: rgb(var(--night));
    box-shadow:
      0 0 0 2px rgb(var(--on-field) / 0.25),
      0 28px 56px rgb(0 0 0 / 0.35);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
