---
const items = [
  { field: 'home', text: 'The ADV 160 and its kilometres.' },
  { field: 'records', text: 'GCash and MariBank, in one total.' },
  { field: 'daily', text: 'Ulam under ₱99.' },
  { field: 'people', text: 'Voice notes in Taglish.' },
];
---

<section class="wrap real">
  <div class="intro">
    <h2>A real life, not a demo.</h2>
    <p>A general app can't join these facts. my-app was built around them, one module at a time.</p>
  </div>
  <ul>
    {items.map((item) => (
      <li>
        <span class={`swatch field-${item.field}`} aria-hidden="true"></span>
        <span class="text">{item.text}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .real {
    padding-block: 96px 88px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: flex-start;
  }

  .intro {
    flex: 1 1 280px;
    min-width: 0;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h2 {
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .intro p {
    color: rgb(var(--fg-muted));
  }

  ul {
    flex: 2 1 520px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 3px solid rgb(var(--fg));
  }

  li:last-child {
    border-bottom: 0;
  }

  .swatch {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background-color: rgb(var(--field));
    background-image:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.14) 0 8px, transparent 8px 16px),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.14) 0 8px, transparent 8px 16px);
  }

  .text {
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
</style>
