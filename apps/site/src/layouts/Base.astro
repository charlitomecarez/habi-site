---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#23205c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Tour bands start in their "before" state only when motion can play.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        // Failsafe: if the page scripts never run, drop the "before" states so nothing stays hidden.
        setTimeout(function () {
          if (!window.__motionReady) document.documentElement.classList.remove('motion');
        }, 2500);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      // Sections marked [data-in] play their entrance once, as they come into view.
      const targets = document.querySelectorAll<HTMLElement>('[data-in]');
      const motion = document.documentElement.classList.contains('motion');

      if (motion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              // Tall sections can never be 20% visible, so filling half the screen counts too.
              const enough =
                entry.intersectionRatio >= 0.2 || entry.intersectionRect.height >= window.innerHeight * 0.5;
              if (!entry.isIntersecting || !enough) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { threshold: [0, 0.1, 0.2, 0.4], rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }
      (window as unknown as { __motionReady: boolean }).__motionReady = true;
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 10;
    padding: 12px 18px;
    border-radius: 12px;
    background: rgb(var(--on-field));
    color: rgb(var(--shell-field));
    font-weight: 900;
    text-decoration: none;
    --focus: var(--on-field);
  }

  .skip:focus {
    top: 12px;
  }
</style>
